---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';
import { stats } from '~/data/home';
import { pageUrl } from '~/data/urls';
import { breadcrumbSchema } from '~/data/schema';
import profile from '~/assets/img/profile-photo.jpg';
import ainuBuilding from '~/assets/img/ainu-building.jpg';

const path = pageUrl('about-us');
const crumbs = [{ name: 'Home', url: '/' }, { name: 'About Us', url: path }];

const values = [
  'Honest and ethical medical advice',
  'Clear explanation of treatment options',
  'Minimal and necessary investigations only',
  'Availability and supportive patient care',
  'Focus on long-term recovery and quality of life',
];
const ukTraining = ['Laser Urology', 'Laparoscopic Urology', 'Endoscopic Stone Surgery', 'Minimally Invasive Prostate Procedures'];
const memberships = [
  'Urological Society of India',
  'South Zone Urological Society of India',
  'Society of Genito-Urinary Surgeons, Telangana',
  'Former Member – European Association of Urology',
  'Former Member – American Urological Association',
];
const pillars = [
  { h: 'Our Vision', p: 'To be a trusted center for advanced and compassionate urological care, delivering ethical, innovative, and patient-focused treatments that improve quality of life and promote long-term wellness.' },
  { h: 'Our Mission', p: 'To provide comprehensive urology care through advanced technology, minimally invasive procedures, accurate diagnosis, and personalized treatment plans while ensuring every patient receives compassionate support, transparency, and the highest standards of medical excellence.' },
  { h: 'Our Philosophy', p: 'Dr. Raghavendra Kulkarni believes that successful treatment begins with listening to the patient and identifying the root cause of the problem. His philosophy focuses on ethical medical practice, evidence-based treatment, minimal unnecessary investigations, and delivering care with honesty, empathy, and precision.' },
];
---
<Base
  title="About Dr Raghavendra Kulkarni — Urologist in Secunderabad"
  description="Dr Raghavendra Kulkarni, senior consultant urologist in Secunderabad with 28+ years of experience, UK fellowship training, and patient-focused urological care."
  path={path}
  image={profile.src}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => (
            <li>{i < crumbs.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
      <h1>About Dr. Raghavendra Kulkarni</h1>
      <p class="page-banner__sub">Senior Consultant Urologist | Endoscopic, Laser &amp; Laparoscopic Surgeon</p>
    </div>
  </section>

  <section class="section sec-about-body">
    <div class="container about__grid">
      <div class="about__media" data-reveal="left">
        <Image src={profile} alt="Dr. Raghavendra Kulkarni, Consultant Urologist, AINU Secunderabad" widths={[380, 640]} sizes="(max-width: 900px) 85vw, 460px" loading="eager" fetchpriority="high" />
        <span class="about__badge">MBBS · MS · MCh Urology</span>
      </div>
      <div class="about__copy prose" data-reveal="right">
        <h2 class="about__lede-h">Compassionate Care Backed by Experience &amp; Precision</h2>
        <p>
          At the Asian Institute of Nephrology and Urology, Secunderabad, Dr. Raghavendra Kulkarni is
          known not only for his clinical excellence, but also for the warmth, trust, and reassurance he
          brings to every patient interaction. With over 28 years of experience in medicine and 14 years
          dedicated exclusively to Urology, he has become a trusted name for patients seeking ethical,
          advanced, and patient-focused urological care.
        </p>
        <p>
          Dr. Kulkarni believes that successful treatment begins with understanding the patient
          completely — their symptoms, concerns, lifestyle, and expectations. His calm and approachable
          nature helps patients feel comfortable discussing even the most sensitive urological problems
          with confidence.
        </p>
        <h2>A Doctor Who Believes in Treating the Root Cause</h2>
        <p>
          Rather than simply managing symptoms, Dr. Kulkarni focuses on identifying the root cause of the
          condition and offering precise, evidence-based treatment plans. His approach is practical,
          transparent, and tailored to every individual patient.
        </p>
        <p><strong>Patients value him for:</strong></p>
        <ul class="ticks">
          {values.map((v) => <li><i><Icon name="check" size={13} /></i>{v}</li>)}
        </ul>
        <div class="intro__cta">
          <a class="btn" href={pageUrl('contact-us')}>Book Appointment</a>
          <a class="btn btn--soft" href={site.phoneHref}><Icon name="phone" size={16} /> {site.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="stats" data-stagger>
        {stats.map((s) => (
          <div class="stats__item">
            <div class="stats__num"><span data-count={s.to} data-suffix={s.suffix}>0</span></div>
            <div class="stats__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section sec-training">
    <div class="container training__grid">
      <div class="training__copy prose" data-reveal="left">
        <span class="eyebrow">Credentials</span>
        <h2>International Training. Advanced Expertise.</h2>
        <p>
          After completing his MBBS, MS, and MCh in Urology, Dr. Kulkarni pursued advanced fellowship
          training in the United Kingdom. He was awarded the prestigious Fellowship of the International
          Surgical Training Programme in Urology by The Royal College of Surgeons, England.
        </p>
        <p><strong>During his time in the UK, he received extensive training in:</strong></p>
        <ul class="ticks ticks--2">
          {ukTraining.map((t) => <li><i><Icon name="check" size={13} /></i>{t}</li>)}
        </ul>
        <p>
          His international exposure allows him to bring globally accepted techniques and modern surgical
          advancements to patients in Hyderabad.
        </p>
        <h2>Professional Memberships</h2>
        <ul class="ticks">
          {memberships.map((m) => <li><i><Icon name="check" size={13} /></i>{m}</li>)}
        </ul>
      </div>
      <div class="training__media" data-reveal="right">
        <Image src={ainuBuilding} alt="Asian Institute of Nephrology and Urology, Vikrampuri Colony, Secunderabad" widths={[420, 720]} sizes="(max-width: 900px) 85vw, 480px" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section section--lavender sec-pillars">
    <div class="container">
      <header class="sec-head" data-reveal>
        <span class="eyebrow">What Guides Us</span>
        <h2>Guiding Path to Exceptional Urological Care</h2>
      </header>
      <div class="pillars" data-stagger>
        {pillars.map((p, i) => (
          <article class="pillar">
            <span class="pillar__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
