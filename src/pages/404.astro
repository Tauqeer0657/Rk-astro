---
import Base from '~/layouts/Base.astro';
import { site } from '~/data/site';
import { pageUrl } from '~/data/urls';
---
<Base title="Page Not Found" description="This page could not be found. Browse urology services, patient guides, or call the clinic in Secunderabad on +91-7411088875." path="/404.html" noindex>
  <section class="section sec-404">
    <div class="container container--narrow" style="text-align:center">
      <span class="eyebrow">Error 404</span>
      <h1>We couldn’t find that page</h1>
      <p>The link may be out of date. Try one of these instead:</p>
      <div class="hero__cta" style="justify-content:center">
        <a class="btn" href="/">Go to Homepage</a>
        <a class="btn btn--soft" href={pageUrl('services')}>Our Services</a>
        <a class="btn btn--soft" href={pageUrl('blog')}>Read the Blog</a>
      </div>
      <p style="margin-top:28px">Or call the clinic directly on <a href={site.phoneHref}><strong>{site.phone}</strong></a>.</p>
    </div>
  </section>
</Base>
