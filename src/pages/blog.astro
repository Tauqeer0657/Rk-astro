---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';
import { pageUrl, postUrl } from '~/data/urls';
import { breadcrumbSchema } from '~/data/schema';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.order - a.data.order);
const cats = [...new Set(posts.map((p) => p.data.category))].sort();
const path = pageUrl('blog');
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Blog', url: path }];
const [lead, ...rest] = posts;
---
<Base
  title="Urology Blog — Kidney Stones, Prostate & UTI Guides"
  description="Patient guides on kidney stones, prostate enlargement, UTIs and urinary health, written and reviewed by Dr Raghavendra Kulkarni, Urologist in Secunderabad."
  path={path}
  image={lead.data.hero.src}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol>
      </nav>
      <h1>Urology Health Guides</h1>
      <p class="page-banner__sub">Clear, practical answers on kidney stones, prostate health, urinary infections and prevention.</p>
    </div>
  </section>

  <section class="section sec-blog">
    <div class="container">
      <div class="blog__filters" data-reveal>
        <button class="chip chip--btn is-active" data-filter="all">All ({posts.length})</button>
        {cats.map((c) => (
          <button class="chip chip--btn" data-filter={c}>{c} ({posts.filter((p) => p.data.category === c).length})</button>
        ))}
      </div>

      <a class="blog-lead" href={postUrl(lead.id)} data-reveal data-cat={lead.data.category}>
        <div class="blog-lead__img">
          <Image src={lead.data.hero} alt={lead.data.heroAlt} widths={[480, 900]} sizes="(max-width: 900px) 92vw, 620px" loading="eager" fetchpriority="high" />
        </div>
        <div class="blog-lead__body">
          <span class="chip">{lead.data.category}</span>
          <h2>{lead.data.title}</h2>
          <p>{lead.data.description}</p>
          <span class="svc-card__go">Read article <Icon name="arrow" size={16} /></span>
        </div>
      </a>

      <div class="blog__grid" data-stagger>
        {rest.map((p) => (
          <a class="blog-card" href={postUrl(p.id)} data-cat={p.data.category}>
            <div class="blog-card__img">
              <Image src={p.data.hero} alt={p.data.heroAlt} widths={[320, 600]} sizes="(max-width: 700px) 90vw, 340px" loading="lazy" />
            </div>
            <span class="chip">{p.data.category}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <span class="svc-card__go">Read More <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>

      <p class="blog__empty" data-empty hidden>No articles in this category yet.</p>
    </div>
  </section>

  <section class="section sec-consult">
    <div class="container consult__cta" data-reveal="zoom">
      <h2>Concerned about a urology symptom?</h2>
      <p>Most urological conditions are far simpler to treat when caught early.</p>
      <div class="hero__cta">
        <a class="btn" href={pageUrl('contact-us')}>Book Appointment</a>
        <a class="btn btn--soft" href={site.phoneHref}><Icon name="phone" size={17} /> {site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // category filter — pure DOM, no framework, no extra request
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-cat]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  btns.forEach((b) =>
    b.addEventListener('click', () => {
      const want = b.dataset.filter;
      btns.forEach((x) => x.classList.toggle('is-active', x === b));
      let shown = 0;
      cards.forEach((c) => {
        const match = want === 'all' || c.dataset.cat === want;
        c.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    })
  );
</script>
