---
interface Props { items: { q: string; a: string }[]; title?: string; eyebrow?: string }
const { items, title = 'Frequently Asked Questions', eyebrow = 'Good to Know' } = Astro.props;
---
<section class="section sec-faq">
  <div class="container container--narrow">
    <header class="sec-head" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </header>
    <div class="faq" data-stagger>
      {items.map((f, i) => (
        <details class="faq__item" name="faq" open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </summary>
          <div class="faq__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
