---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import Faq from '~/components/Faq.astro';
import ContactForm from '~/components/ContactForm.astro';
import { site } from '~/data/site';
import { pageUrl } from '~/data/urls';
import { serviceSchema, breadcrumbSchema, faqSchema } from '~/data/schema';

export async function getStaticPaths() {
  const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
  return all.map((svc) => ({
    params: { service: svc.id },
    props: { svc, others: all.filter((s) => s.id !== svc.id) },
  }));
}

const { svc, others } = Astro.props;
const { data } = svc;
const { Content } = await render(svc);
const path = pageUrl(svc.id);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: pageUrl('services') },
  { name: data.title, url: path },
];

const schemas = [
  serviceSchema({ name: data.title, description: data.description, url: new URL(path, site.url).href }),
  breadcrumbSchema(crumbs),
  ...(data.faqs.length ? [faqSchema(data.faqs)] : []),
];
---
<Base title={data.title} description={data.description} path={path} image={data.hero.src} schemas={schemas}>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => (
            <li>{i < crumbs.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
      <h1>{data.title}</h1>
      <p class="page-banner__sub">{data.short}</p>
    </div>
  </section>

  <section class="section sec-service">
    <div class="container svc__wrap">
      <div class="svc__main">
        <figure class="svc__hero" data-reveal>
          <Image src={data.hero} alt={data.title} widths={[480, 820]} sizes="(max-width: 900px) 100vw, 740px" loading="eager" fetchpriority="high" />
        </figure>
        <div class="prose" data-reveal><Content /></div>

        <div class="svc__cta" data-reveal="zoom">
          <div>
            <h3>Not sure which treatment you need?</h3>
            <p>Bring your reports — a single consultation usually settles the question.</p>
          </div>
          <div class="svc__cta-btns">
            <a class="btn" href={pageUrl('contact-us')}>Book Appointment</a>
            <a class="btn btn--soft" href={site.phoneHref}><Icon name="phone" size={16} /> Call</a>
          </div>
        </div>
      </div>

      <aside class="svc__side">
        <div class="side-card">
          <h4>Other Services</h4>
          <ul class="side-links">
            {others.map((o) => <li><a href={pageUrl(o.id)}>{o.data.title} <Icon name="arrow" size={14} /></a></li>)}
          </ul>
        </div>
        <div class="side-card side-card--brand">
          <h4>Consult Dr. Kulkarni</h4>
          <p>{site.clinic.name}, {site.clinic.locality}</p>
          <a class="btn btn--block" href={site.phoneHref}>{site.phone}</a>
          <a class="btn btn--soft btn--block" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        </div>
        <div class="side-card">
          <h4>Quick Enquiry</h4>
          <ContactForm compact />
        </div>
      </aside>
    </div>
  </section>

  {data.faqs.length > 0 && <Faq items={data.faqs} title={`${data.title} — Common Questions`} />}
</Base>
